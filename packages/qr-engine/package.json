{
  "name": "@consulta-dev/qr-engine",
  "version": "0.1.13",
  "description": "Browser QR extraction interface for Consulta Autofill.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/consulta-dev-br/consulta-autofill.git",
    "directory": "packages/qr-engine"
  },
  "bugs": {
    "url": "https://github.com/consulta-dev-br/consulta-autofill/issues"
  },
  "homepage": "https://github.com/consulta-dev-br/consulta-autofill#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "benchmark": "node ./scripts/benchmark.mjs",
    "qr-only:build": "node ./scripts/build-qr-only.mjs",
    "qr-only:verify": "node ./scripts/verify-qr-only.mjs",
    "qr-only:reproducible": "node ./scripts/verify-qr-only-reproducible.mjs",
    "qr-only:test": "node ./scripts/test-qr-only-artifact.mjs",
    "qr-only:parity": "node ./scripts/parity-qr-only.mjs",
    "qr-only:benchmark": "pnpm run build && pnpm run qr-only:verify && node ./scripts/benchmark-qr-only.mjs",
    "qr-only:firefox": "node ./scripts/benchmark-qr-only.mjs --browser=firefox --mode=compatibility",
    "qr-only:webkit": "node ./scripts/benchmark-qr-only.mjs --browser=webkit --mode=compatibility",
    "qr-only:edge": "node ./scripts/benchmark-qr-only.mjs --browser=edge --mode=compatibility"
  },
  "dependencies": {
    "zxing-wasm": "3.1.3"
  }
}
