{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consulta.dev.br/schemas/autofill/v1/autofill.schema.json",
  "title": "Consulta Autofill v1 contract",
  "description": "Public partner and iframe contract. It contains no VIO decoder implementation or document data.",
  "$defs": {
    "protocolVersion": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "pattern": "^pub_[A-Za-z0-9_-]{8,128}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^afs_[A-Za-z0-9_-]{8,128}$"
    },
    "requestId": {
      "type": "string",
      "pattern": "^req_[A-Za-z0-9_-]{8,128}$"
    },
    "nonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "sessionToken": {
      "type": "string",
      "minLength": 32,
      "maxLength": 4096
    },
    "base64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 1048576,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "documentType": {
      "type": "string",
      "enum": ["auto", "cnh-e", "crlv-e"]
    },
    "decodedDocumentType": {
      "type": "string",
      "enum": ["cnh-e", "crlv-e"]
    },
    "metricEvent": {
      "type": "string",
      "enum": [
        "opened",
        "camera_requested",
        "camera_granted",
        "camera_denied",
        "qr_found",
        "decoded",
        "confirmed",
        "filled",
        "closed",
        "error"
      ]
    },
    "branding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "name", "accent_color", "show_powered_by"],
          "properties": {
            "mode": { "const": "consulta" },
            "name": { "const": "Consulta Autofill" },
            "accent_color": { "const": "#155EEF" },
            "show_powered_by": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "name", "accent_color", "show_powered_by"],
          "properties": {
            "mode": { "const": "partner" },
            "name": { "type": "string", "minLength": 1, "maxLength": 60 },
            "accent_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "show_powered_by": { "const": false }
          }
        }
      ]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout"],
      "properties": {
        "layout": { "type": "string", "enum": ["compact", "standard"] }
      }
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "INVALID_REQUEST",
        "UNAUTHENTICATED",
        "INVALID_API_KEY",
        "INVALID_PRODUCT",
        "INVALID_ORIGIN",
        "INVALID_SESSION",
        "SESSION_EXPIRED",
        "SESSION_REPLAYED",
        "SESSION_ATTEMPTS_EXCEEDED",
        "PROJECT_NOT_FOUND",
        "PROJECT_DISABLED",
        "AUTOFILL_BETA_REQUIRED",
        "DOCUMENT_NOT_ALLOWED",
        "PHOTO_NOT_ALLOWED",
        "CAMERA_DENIED",
        "CAMERA_UNAVAILABLE",
        "FILE_UNSUPPORTED",
        "QR_NOT_FOUND",
        "DECODE_FAILED",
        "RATE_LIMITED",
        "UPSTREAM_UNAVAILABLE",
        "INTERNAL_ERROR"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "$ref": "#/$defs/errorCode" },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "retryable": { "type": "boolean" }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "error", "request_id"],
      "properties": {
        "success": { "const": false },
        "error": { "$ref": "#/$defs/error" },
        "request_id": { "$ref": "#/$defs/requestId" }
      }
    },
    "sessionCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "document_type"],
      "properties": {
        "protocol_version": { "$ref": "#/$defs/protocolVersion" },
        "document_type": { "$ref": "#/$defs/documentType" }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "session_token",
        "project_id",
        "expires_at",
        "embed_url",
        "bootstrap_url",
        "allowed_document_types",
        "photo_enabled"
      ],
      "properties": {
        "session_id": { "$ref": "#/$defs/sessionId" },
        "session_token": { "$ref": "#/$defs/sessionToken" },
        "project_id": { "$ref": "#/$defs/projectId" },
        "expires_at": { "type": "string", "format": "date-time" },
        "embed_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "bootstrap_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "allowed_document_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/decodedDocumentType" }
        },
        "photo_enabled": { "type": "boolean" }
      }
    },
    "sessionSuccessResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "data", "request_id"],
      "properties": {
        "success": { "const": true },
        "data": { "$ref": "#/$defs/session" },
        "request_id": { "$ref": "#/$defs/requestId" }
      }
    },
    "metricRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "session_token", "event"],
      "properties": {
        "protocol_version": { "$ref": "#/$defs/protocolVersion" },
        "session_token": { "$ref": "#/$defs/sessionToken" },
        "event": { "$ref": "#/$defs/metricEvent" }
      }
    },
    "metricSuccessResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "data", "request_id"],
      "properties": {
        "success": { "const": true },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accepted"],
          "properties": { "accepted": { "const": true } }
        },
        "request_id": { "$ref": "#/$defs/requestId" }
      }
    },
    "embedBootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "project_id",
        "session_id",
        "expires_at",
        "allowed_document_types",
        "photo_enabled",
        "branding"
      ],
      "properties": {
        "protocol_version": { "$ref": "#/$defs/protocolVersion" },
        "project_id": { "$ref": "#/$defs/projectId" },
        "session_id": { "$ref": "#/$defs/sessionId" },
        "expires_at": { "type": "string", "format": "date-time" },
        "allowed_document_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/decodedDocumentType" }
        },
        "photo_enabled": { "type": "boolean" },
        "branding": { "$ref": "#/$defs/branding" },
        "presentation": { "$ref": "#/$defs/presentation" }
      }
    },
    "embedBootstrapSuccessResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "data", "request_id"],
      "properties": {
        "success": { "const": true },
        "data": { "$ref": "#/$defs/embedBootstrap" },
        "request_id": { "$ref": "#/$defs/requestId" }
      }
    },
    "decodeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "session_token", "payload_base64", "include_photo"],
      "properties": {
        "protocol_version": { "$ref": "#/$defs/protocolVersion" },
        "session_token": { "$ref": "#/$defs/sessionToken" },
        "payload_base64": { "$ref": "#/$defs/base64" },
        "include_photo": { "type": "boolean" }
      }
    },
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mime_type", "base64"],
      "properties": {
        "mime_type": { "type": "string", "enum": ["image/jpeg", "image/png"] },
        "base64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 6990508,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "decodeData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "fields", "photo"],
      "properties": {
        "document": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "label"],
          "properties": {
            "type": { "$ref": "#/$defs/decodedDocumentType" },
            "label": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        },
        "fields": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "additionalProperties": { "type": "string", "maxLength": 4096 }
        },
        "photo": {
          "anyOf": [
            { "$ref": "#/$defs/photo" },
            { "type": "null" }
          ]
        }
      }
    },
    "decodeSuccessResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "data", "request_id"],
      "properties": {
        "success": { "const": true },
        "data": { "$ref": "#/$defs/decodeData" },
        "request_id": { "$ref": "#/$defs/requestId" }
      }
    },
    "frameMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "type", "project_id", "session_id", "nonce"],
      "properties": {
        "protocol": { "const": "consulta-autofill" },
        "version": { "$ref": "#/$defs/protocolVersion" },
        "type": {
          "type": "string",
          "enum": [
            "parent.session",
            "embed.payload",
            "parent.result",
            "parent.error",
            "parent.close",
            "embed.cancel",
            "embed.confirm",
            "embed.metric"
          ]
        },
        "project_id": { "$ref": "#/$defs/projectId" },
        "session_id": { "$ref": "#/$defs/sessionId" },
        "nonce": { "$ref": "#/$defs/nonce" },
        "payload": {}
      }
    },
    "embedReadyMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "type", "project_id", "nonce"],
      "properties": {
        "protocol": { "const": "consulta-autofill" },
        "version": { "$ref": "#/$defs/protocolVersion" },
        "type": { "const": "embed.ready" },
        "project_id": { "$ref": "#/$defs/projectId" },
        "nonce": { "$ref": "#/$defs/nonce" }
      }
    }
  }
}
