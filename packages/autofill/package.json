{
  "name": "@consulta-dev/autofill",
  "version": "0.1.13",
  "description": "Consulta Autofill web component for document-assisted form completion.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": true,
  "files": ["dist", "contracts"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./contracts/v1/autofill.schema.json": "./contracts/v1/autofill.schema.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/consulta-dev-br/consulta-autofill.git",
    "directory": "packages/autofill"
  },
  "bugs": {
    "url": "https://github.com/consulta-dev-br/consulta-autofill/issues"
  },
  "homepage": "https://github.com/consulta-dev-br/consulta-autofill#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  }
}
